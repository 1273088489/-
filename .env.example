# Quanzhan 环境变量示例。复制为 .env.local 后按需修改。
# ------------------------------------------------------------------
# AI 提供商
# AI_PROVIDER=mock | openai
AI_PROVIDER=mock
# 使用 openai provider 时必填：
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# API 协议：chat_completions（默认）或 responses
# OPENAI_API_MODE=chat_completions

# 数据库路径（默认项目根 quanzhan.db；测试会覆盖）
# DB_PATH=./quanzhan.db

# 服务端口
# PORT=3000

# 持久学习终端：TERMINAL_IMAGE 只接受两种内容寻址引用，运行时绝不自动 docker pull
# 生产：registry digest pin（部署前由运维显式预拉取）：
# TERMINAL_IMAGE=registry.example.com/quanzhan/ttyd:版本@sha256:<64位小写十六进制 digest>
#   docker pull "$TERMINAL_IMAGE"
# 开发：本地构建镜像（docker/ttyd-node.Dockerfile），用裸 sha256:<image-id> 引用，无需预拉取：
#   docker build -f docker/ttyd-node.Dockerfile -t qz-ttyd-node:local .
# TERMINAL_IMAGE=sha256:<64位小写十六进制 image-id>
# TERMINAL_INSTANCE_ID=local-dev
# TERMINAL_TTL_MS=86400000
