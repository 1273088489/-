# Quanzhan 环境变量示例。复制为 .env.local 后按需修改。
# ------------------------------------------------------------------
# AI 提供商
# AI_PROVIDER=mock | openai
AI_PROVIDER=mock
# 使用 openai provider 时必填：
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# API 协议：chat_completions（默认）或 responses
# OPENAI_API_MODE=chat_completions

# 数据库路径（默认项目根 quanzhan.db；测试会覆盖）
# DB_PATH=./quanzhan.db

# 服务端口
# PORT=3000

# 持久学习终端：运行时只接受本机已预拉取的完整 image digest，绝不自动 docker pull
# TERMINAL_IMAGE=registry.example.com/quanzhan/ttyd:版本@sha256:<64位小写十六进制 digest>
# TERMINAL_INSTANCE_ID=local-dev
# TERMINAL_TTL_MS=86400000
# 部署前由运维显式预拉取：docker pull "$TERMINAL_IMAGE"
