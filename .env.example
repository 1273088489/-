# Quanzhan 环境变量示例。复制为 .env.local 后按需修改。
# ------------------------------------------------------------------
# AI 提供商
# AI_PROVIDER=mock | openai
AI_PROVIDER=mock
# 使用 openai provider 时必填：
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# 数据库路径（默认项目根 quanzhan.db；测试会覆盖）
# DB_PATH=./quanzhan.db

# 服务端口
# PORT=3000
